{
  "manifest_version": 3,
  "name": "MediathekAtlas Videostart",
  "short_name": "Videostart",
  "version": "0.6.78",
  "description": "Startet Videos von Rakuten TV, Joyn, TOGGO, JustWatch TV, Crunchyroll und RTL+, die aus MediathekAtlas geöffnet werden, ohne weitere Klicks und im Vollbild. Meldet MediathekAtlas den Installationsstand und aktualisiert sich selbst. Kein Umgehen von Kopierschutz.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.rakuten.tv/*",
        "https://www.joyn.de/*",
        "https://www.toggo.de/*",
        "https://www.justwatch.com/*",
        "https://www.crunchyroll.com/*",
        "https://plus.rtl.de/*"
      ],
      "js": [
        "autostart.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "atlas_bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "MediathekAtlas Videostart",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
